{
  "name": "@hht/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @perf --project=chromium --project=firefox",
    "perf": "playwright test --grep @perf --project=chromium",
    "e2e:webkit": "playwright test --grep-invert @perf --project=webkit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@hht/shared": "workspace:*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
