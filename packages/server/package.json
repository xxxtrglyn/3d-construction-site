{
  "name": "@hht/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "HHT_METRICS=1 HHT_DEV_CHEATS=1 node --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "loadtest": "node --expose-gc loadtest/run.ts",
    "reports": "node scripts/reports.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/schema": "5.0.43",
    "@colyseus/ws-transport": "0.18.4",
    "@hht/shared": "workspace:*",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
