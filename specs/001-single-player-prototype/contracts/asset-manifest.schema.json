{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hht/asset-manifest.v1",
  "title": "Hard Hat Town asset manifest",
  "description": "Written by tools/assets/compress.mjs to packages/client/public/assets/manifest.json. Read by the client loader and by tools/assets/check-budgets.mjs.",
  "type": "object",
  "required": ["version", "generatedAt", "assets"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "bytes", "sha256", "group"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "examples": ["worker", "lot", "pieces", "racks", "fx", "clock-tower-stage-0", "clock-tower-stage-6"]
          },
          "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.[0-9a-f]{8}\\.glb$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "group": { "enum": ["critical", "deferred"] },
          "nodes": {
            "description": "Named nodes the client relies on (slot anchors, attach points), so missing nodes fail at build time.",
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
